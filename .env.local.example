# ==========================================
# Colonel's Pickle — Environment Variables
# Ridhwika Agro Organics, Jaipur
# ==========================================

# ==========================================
# DATABASE
# ==========================================

# MongoDB Connection URI
# Local: mongodb://localhost:27017/colonels-pickle
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/colonels-pickle
MONGODB_URI=mongodb://localhost:27017/colonels-pickle

# ==========================================
# NEXTAUTH / AUTHENTICATION
# ==========================================

# NextAuth URL (your application URL, used for redirect callbacks)
# Development: http://localhost:3000
# Production: https://colonelspickle.in
NEXTAUTH_URL=http://localhost:3000

# NextAuth Secret (REQUIRED — Generate with: openssl rand -base64 32)
# Must be a random, cryptographically secure string. Rotate before production.
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32

# ==========================================
# PUBLIC APPLICATION URLS
# ==========================================

# Public Application URL (for links in emails, SMS, webhooks, admin app)
# Development: http://localhost:3000
# Production: https://colonelspickle.in
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public Site URL (for sitemap, robots.txt, OG tags)
# Development: http://localhost:3000
# Production: https://colonelspickle.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==========================================
# GOOGLE OAUTH
# ==========================================

# Get credentials from: https://console.cloud.google.com/
# 1. Create a new project
# 2. Enable Google+ API
# 3. Create OAuth 2.0 credentials (type: Web application)
# 4. Add authorized redirect URI:
#    Development: http://localhost:3000/api/auth/callback/google
#    Production: https://colonelspickle.in/api/auth/callback/google

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ==========================================
# CASHFREE PAYMENT GATEWAY
# ==========================================

# Get credentials from: https://merchant.cashfree.com/
# 1. Sign up / login at Cashfree Merchant Dashboard
# 2. Navigate to Developers > API Keys
# 3. Copy App ID and Secret Key

CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key

# Environment: sandbox or production (default: sandbox)
CASHFREE_ENV=sandbox

# Return URL (where Cashfree redirects after payment)
# Development: http://localhost:3000/api/payment/callback
# Production: https://colonelspickle.in/api/payment/callback
CASHFREE_RETURN_URL=http://localhost:3000/api/payment/callback

# ==========================================
# CLOUDINARY MEDIA HOSTING
# ==========================================

# Get credentials from: https://cloudinary.com/
# 1. Sign up / login to your Cloudinary dashboard
# 2. Go to Settings > API Keys
# 3. Copy Cloud Name, API Key, and API Secret

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==========================================
# EMAIL NOTIFICATIONS (SMTP)
# ==========================================

# SMTP Configuration (Gmail recommended for development)
# To use Gmail:
#   1. Enable 2-Factor Authentication on your Gmail account
#   2. Generate App Password: https://myaccount.google.com/apppasswords
#   3. Use the 16-character app password below

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com

# Note: code checks both SMTP_PASS and SMTP_PASSWORD; provide at least one
SMTP_PASS=your-16-char-app-password
SMTP_PASSWORD=your-16-char-app-password

# From Email Address (shown in recipient's inbox)
# Format: "Name <email@domain.com>"
SMTP_FROM=Colonel's Pickle <noreply@colonelspickle.in>
EMAIL_FROM=Colonel's Pickle <noreply@colonelspickle.in>

# Alternative SMTP Providers:
# SendGrid: smtp.sendgrid.net (Port: 587)
# Mailgun: smtp.mailgun.org (Port: 587)
# Amazon SES: email-smtp.region.amazonaws.com (Port: 587)
# ProtonMail: smtp.protonmailsmtp.com (Port: 587)

# ==========================================
# DELHIVERY SHIPPING API
# ==========================================

# Get API key from: https://www.delhivery.com/
# Contact Delhivery support for staging/production credentials

# API Key
DELHIVERY_API_KEY=your_delhivery_api_key

# API Base URL
# Production: https://one.delhivery.com
# Staging (if available): https://staging-express.delhivery.com
DELHIVERY_BASE_URL=https://one.delhivery.com

# Warehouse / Return Address (Colonel's Pickle, Jaipur)
DELHIVERY_RETURN_PINCODE=302020
DELHIVERY_RETURN_ADDRESS=B-6/374, Vaishali Nagar
DELHIVERY_RETURN_CITY=Jaipur
DELHIVERY_RETURN_STATE=Rajasthan
DELHIVERY_RETURN_COUNTRY=India
DELHIVERY_RETURN_NAME=Colonel's Pickle
DELHIVERY_RETURN_PHONE=9717243306

# Webhook Secret (secure random string used to verify incoming webhook payloads)
# Generate with: openssl rand -hex 32
DELHIVERY_WEBHOOK_SECRET=your-random-secure-webhook-secret-string

# ==========================================
# SHIPROCKET SHIPPING API (OPTIONAL)
# ==========================================

# Get credentials from: https://www.shiprocket.in/
# 1. Sign up / login to Shiprocket dashboard
# 2. Navigate to Settings > Integrations > API

SHIPROCKET_EMAIL=your-shiprocket-email@example.com
SHIPROCKET_PASSWORD=your-shiprocket-password

# Webhook Secret (secure random string)
# Generate with: openssl rand -hex 32
SHIPROCKET_WEBHOOK_SECRET=your-random-secure-webhook-secret-string

# Pickup Location (Shiprocket warehouse/store ID — contact Shiprocket for this)
SHIPROCKET_PICKUP_LOCATION=your_pickup_location_id

# Default Package Dimensions (in cm) for Shiprocket calculations
SHIPROCKET_DEFAULT_LENGTH=15
SHIPROCKET_DEFAULT_BREADTH=12
SHIPROCKET_DEFAULT_HEIGHT=10

# ==========================================
# WAREHOUSE CONFIGURATION
# ==========================================

# Warehouse Pincode (used for shipping calculations)
# Colonel's Pickle warehouse is in Jaipur
WAREHOUSE_PINCODE=302020

# ==========================================
# SMS NOTIFICATIONS (FAST2SMS)
# ==========================================

# Get API key from: https://www.fast2sms.com/
# 1. Sign up for Fast2SMS account
# 2. Navigate to API Dashboard
# 3. Copy your Authorization/API Key

FAST2SMS_API_KEY=your_fast2sms_api_key

# Admin Phone Number (for receiving SMS notifications)
# Format: +91XXXXXXXXXX or 9XXXXXXXXXX
ADMIN_PHONE=919717243306

# ==========================================
# ADMIN CONFIGURATION
# ==========================================

# Admin Email (comma-separated list of email addresses that get admin role)
# Users with these emails can access the /admin dashboard
# Recommendation: use a corporate email like colonelspickle@proton.me
ADMIN_EMAIL=colonelspickle@proton.me

# ==========================================
# TELEGRAM ALERTS (OPTIONAL)
# ==========================================

# Used for sending real-time alerts to admin on order/payment/shipping events
# Get credentials from: https://telegram.org/

# Telegram Bot Token
# Create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather

# Telegram Chat ID (your personal or group chat where alerts are sent)
# Get your chat ID by messaging @userinfobot
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ==========================================
# INTERNAL API SECURITY
# ==========================================

# Secret token used for internal API calls (e.g., shipment queue polling)
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=your-random-secure-internal-api-secret

# ==========================================
# LOGGING & DEBUGGING
# ==========================================

# Log Level (ERROR, WARN, INFO, DEBUG, TRACE)
# Development: DEBUG
# Production: INFO or WARN
LOG_LEVEL=DEBUG

# Node Environment
# development | production | test
NODE_ENV=development

# ==========================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ==========================================
# Before deploying to production, complete these steps:
#
# Authentication & Security:
#   [ ] Generate NEW NEXTAUTH_SECRET with: openssl rand -base64 32
#   [ ] Generate NEW INTERNAL_API_SECRET with: openssl rand -hex 32
#   [ ] Rotate DELHIVERY_WEBHOOK_SECRET and SHIPROCKET_WEBHOOK_SECRET
#   [ ] Ensure all callback URLs point to https://colonelspickle.in
#
# URLs & Domains:
#   [ ] Update NEXTAUTH_URL to https://colonelspickle.in
#   [ ] Update NEXT_PUBLIC_APP_URL to https://colonelspickle.in
#   [ ] Update NEXT_PUBLIC_SITE_URL to https://colonelspickle.in
#   [ ] Update CASHFREE_RETURN_URL to https://colonelspickle.in/api/payment/callback
#   [ ] Add https://colonelspickle.in/api/auth/callback/google to Google OAuth authorized redirects
#   [ ] Add https://colonelspickle.in webhook URLs to Delhivery/Shiprocket dashboards
#
# Payment & Shipping:
#   [ ] Switch CASHFREE_ENV from sandbox to production
#   [ ] Verify production Cashfree credentials are set
#   [ ] Verify production Delhivery API key is active
#   [ ] Verify production Shiprocket credentials (if using)
#   [ ] Update WAREHOUSE_PINCODE to production warehouse location
#
# Email & Notifications:
#   [ ] Use production SMTP credentials (ProtonMail recommended)
#   [ ] Update SMTP_FROM and EMAIL_FROM to colonelspickle@proton.me (or corporate email)
#   [ ] Verify all SMTP ports are accessible (usually 587 or 465)
#   [ ] Verify FAST2SMS API key is production-enabled
#   [ ] Set ADMIN_PHONE to live notification number
#   [ ] Set ADMIN_EMAIL to live admin addresses (comma-separated)
#   [ ] Configure TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID for alerts
#
# Environment:
#   [ ] Set NODE_ENV=production
#   [ ] Set LOG_LEVEL=INFO or WARN (not DEBUG)
#   [ ] Verify MONGODB_URI points to production database
#   [ ] Verify all API keys are production/live (not sandbox/test)
#
# Testing:
#   [ ] Test complete checkout flow end-to-end
#   [ ] Test order confirmation email
#   [ ] Test shipping integration (create test shipment)
#   [ ] Test Cashfree payment callback
#   [ ] Test Delhivery webhook
#   [ ] Monitor logs for errors
#   [ ] Verify OG tags and sitemap are correct
#
# ==========================================
